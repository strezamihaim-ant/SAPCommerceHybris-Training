# ImpEx for Importing Tour and dates for a band

# Macros / Replacement Parameter definitions
$productCatalog=concertoursProductCatalog
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$supercategories=supercategories(code, $catalogVersion)
$baseProduct=baseProduct(code,$catalogVersion)
$approved=approvalstatus(code)[default='approved']
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]

# Product catalog
INSERT_UPDATE Catalog;id[unique=true]   ;name[lang=en]
                     ;$productCatalog   ;Concert Tours Product Catalog

# Product cataog version
INSERT_UPDATE CatalogVersion;catalog(id)[unique=true];version[unique=true];active;languages(isoCode);readPrincipals(uid)
                            ;$productCatalog;Staged;true;en;employeegroup

# Insert Products
INSERT_UPDATE Product;code[unique=true];name[lang=en];band(code);$supercategories;manufacturerName;manufacturerAID;unit(code);ean;variantType(code);$catalogVersion;$approved
                     ;201701;The Grand Little x Tour;A001;;x;y;pieces;;Concert

# Insert Products
INSERT_UPDATE Concert;code[unique=true];name[lang=en];date[dateformat=dd.MM.yyyy];venue;concertType(code);baseProduct(code);$catalogVersion;$approved
                     ;20170101;Grand Tour - Munich;03.02.2027;"hybris Munich, Germany";OPENAIR;201701;
                     ;20170102;Grand Tour - London;21.03.2027;"hybris London, UK";OPENAIR;201701;
                     ;20170103;Grand Tour - Montreal;15.06.2027;"hybris Montreal, Canada";INDOOR;201701;
                     ;20170104;Grand Tour - Gliwice;04.11.2027;"hybris Gliwice, Poland";INDOOR;201701;
                     ;20170105;Grand Tour - Boulder;07.01.2028;"hybris Boulder, USA";INDOOR;201701;
                     ;20170106;Grand Tour - Boston;;"hybris Boston, USA";;201701;
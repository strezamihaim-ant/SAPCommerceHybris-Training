<items 	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
			xsi:noNamespaceSchemaLocation="items.xsd">

	<enumtypes>
		<enumtype code="ConcertType" autocreate="true" generate="true">
			<value code="indoor"/>
			<value code="openair"/>
		</enumtype>

		<enumtype code="MusicType" autocreate="true" generate="true" dynamic="true"/>
	</enumtypes>

	<relations>
		<!-- Many-to-many relationship between Band and MusicType -->
		<relation code="Band2MusicTypeRelation" generate="true" autocreate="true" localized="false">
			<deployment table="Band2MusicTypeRel" typecode="10106"/>
			<sourceElement type="Band" qualifier="bands" cardinality="many">
				<modifiers read="true" write="true" search="true" optional="true"/>
			</sourceElement>
			<targetElement type="MusicType" qualifier="musicTypes" cardinality="many">
				<modifiers read="true" write="true" search="true" optional="true"/>
			</targetElement>
		</relation>

		<!-- One-to-many relationship between Band and Product -->
		<relation code="Band2ProductRelation" generate="true" autocreate="true" localized="false">
			<sourceElement type="Band" qualifier="band" cardinality="one">
				<modifiers read="true" write="true" search="true" optional="true"/>
			</sourceElement>
			<targetElement type="Product" qualifier="products" cardinality="many">
				<modifiers read="true" write="true" search="true" optional="true"/>
			</targetElement>
		</relation>
	</relations>

	<itemtypes>
		<itemtype code="Concert" autocreate="true" generate="true"
				  extends="VariantProduct">
			<deployment table="Concerts" typecode="10103"/>
			<attributes>
				<attribute qualifier="venue" type="java.lang.String">
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="date" type="java.util.Date">
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="concertType" type="ConcertType">
					<persistence type="property"/>
				</attribute>
			</attributes>
		</itemtype>

		<itemtype code="Band" autocreate="true" generate="true"
				  jaloclass="com.lcc.core.jalo.Band"
				  extends="GenericItem">
			<deployment table="Bands" typecode="10101"/>
			<attributes>
				<attribute qualifier="code" type="java.lang.String">
					<persistence type="property"/>
					<modifiers optional="false" unique="true" initial="true"/>
				</attribute>
				<attribute qualifier="name" type="java.lang.String">
					<persistence type="property"/>
					<modifiers optional="false"/>
				</attribute>
				<attribute qualifier="history" type="localized:java.lang.String">
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="albumSales" type="java.lang.Long">
					<persistence type="property"/>
				</attribute>
			</attributes>
		</itemtype>

		<itemtype code="Product"
				  autocreate="false"
				  generate="false">
			<attributes>
				<attribute qualifier="hashtag" type="localized:java.lang.String">
					<persistence type="property"/>
					<modifiers optional="true" read="true" write="true" search="true"/>
					<description>Hashtag of the concert tour for social media</description>
				</attribute>
			</attributes>
		</itemtype>
	</itemtypes>

</items>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<config xmlns="http://www.hybris.com/cockpit/config"
		xmlns:wz="http://www.hybris.com/cockpitng/config/wizard-config">
	<context component="explorer-tree" merge-by="module">
		<explorer-tree:explorer-tree xmlns:explorer-tree="http://www.hybris.com/cockpitng/config/explorertree">
			<explorer-tree:navigation-node id="Music">
				<explorer-tree:type-node id="Band" code="Band"/>
				<explorer-tree:type-node id="Concert" code="Concert"/>
				<explorer-tree:type-node id="News" code="News"/>
			</explorer-tree:navigation-node>
		</explorer-tree:explorer-tree>
	</context>

	<context type="Concert" component="advanced-search" merge-by="type">
		<advanced-search:advanced-search xmlns:advanced-search="http://www.hybris.com/cockpitng/config/advancedsearch">
			<advanced-search:field-list>
				<advanced-search:field name="venue" operator="STARTS_WITH" selected="true"/>
				<advanced-search:field name="date" operator="BETWEEN" selected="true"/>
				<advanced-search:field name="concertType" operator="EQUALS" selected="true"/>
			</advanced-search:field-list>
		</advanced-search:advanced-search>
	</context>

	<context type="Concert" component="listview" merge-by="type">
		<list-view:list-view xmlns:list-view="http://www.hybris.com/cockpitng/component/listView">
			<list-view:column qualifier="venue"/>
			<list-view:column qualifier="date"/>
			<list-view:column qualifier="concertType"/>
		</list-view:list-view>
	</context>

	<context type="Band" component="create-wizard">
		<wz:flow id="BandCreateWizard" title="wizard.band.create.title">
			<wz:prepare id="prepare">
				<wz:initialize property="newBand" type="ctx.TYPE_CODE"/>
			</wz:prepare>

			<wz:step id="step1" label="wizard.band.step1.label">
				<wz:content id="step1.content">
					<wz:property-list root="newBand">
						<wz:property qualifier="code"/>
						<wz:property qualifier="name"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="step1.navigation">
					<wz:cancel/>
					<wz:next visible="newBand.code != null AND newBand.code != ''"/>
				</wz:navigation>
			</wz:step>

			<wz:step id="step2" label="wizard.band.step2.label">
				<wz:content id="step2.content">
					<wz:property-list root="newBand">
						<wz:property qualifier="history"/>
						<wz:property qualifier="albumSales"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="step2.navigation">
					<wz:cancel/>
					<wz:back/>
					<wz:next/>
				</wz:navigation>
			</wz:step>

			<wz:step id="step3" label="wizard.band.step3.label">
				<wz:content id="step3.content">
					<wz:property-list root="newBand">
						<wz:property qualifier="concerts" editor="com.hybris.cockpitng.editor.extendedmultireferenceeditor"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="step3.navigation">
					<wz:cancel/>
					<wz:back/>
					<wz:done>
						<wz:save property="newBand"/>
					</wz:done>
				</wz:navigation>
			</wz:step>
		</wz:flow>
	</context>

	<context type="Concert" component="editor-area" merge-by="type">
		<editorArea:editorArea xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea">
			<editorArea:tab name="tab.concert.properties" position="3">
				<editorArea:section name="section.concert.properties">
					<editorArea:attribute qualifier="venue"/>
					<editorArea:attribute qualifier="date"/>
					<editorArea:attribute qualifier="concertType"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>
</config>